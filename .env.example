# Database (matches docker-compose.yml service `db`)
POSTGRES_USER=musiciansearch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=musiciansearch
DATABASE_URL=postgresql://musiciansearch:changeme@db:5432/musiciansearch

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_RETURN_URL=
STRIPE_BILLING_PRICE_ID=

# Dev-only: bypass Stripe Identity with a local simulated verification page,
# so the rest of the app can be built before real Stripe keys are wired up.
# Ignored outside development regardless of this value (see src/lib/config.ts).
# Never set this in a production environment.
MOCK_IDENTITY_VERIFICATION=false

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Dev-only: bypass real Twilio SMS sending; signup/verify accept a fixed test
# code instead (see src/lib/config.ts). Same production-safety gate as
# MOCK_IDENTITY_VERIFICATION above. Never set this in a production environment.
MOCK_OTP_VERIFICATION=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=
